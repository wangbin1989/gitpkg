{
  "schema": "https://raw.githubusercontent.com/wangbin1989/GitPkg/main/schema.json#",
  "tools": [
    {
      "repo": "cli/cli",
      "name": "github-cli"
    },
    {
      "repo": "colbymchenry/codegraph",
      "platforms": [
        {
          "rid": "osx-arm64",
          "link": [{ "source": "bin/codegraph" }]
        },
        {
          "rid": "win-x64",
          "link": [{ "source": "bin/codegraph.cmd" }]
        }
      ]
    },
    {
      "repo": "dotnet/cli-lab",
      "name": "dotnet-core-uninstall"
    },
    {
      "repo": "podman-container-tools/podman",
      "platforms": [
        {
          "rid": "osx-arm64",
          "link": [{ "source": "usr/bin/podman" }]
        },
        {
          "rid": "win-x64",
          "link": [{ "source": "usr/bin/podman.exe" }]
        }
      ]
    },
    {
      "repo": "ggml-org/llama.cpp",
      "platforms": [
        {
          "rid": "osx-arm64",
          "link": [{ "source": "llama-cli" }, { "source": "llama-server" }]
        },
        {
          "rid": "win-x64",
          "link": [
            { "source": "llama-cli.exe" },
            { "source": "llama-server.exe" }
          ]
        }
      ]
    },
    {
      "repo": "openai/codex",
      "platforms": [
        {
          "rid": "osx-arm64",
          "asset": "codex-aarch64-apple-darwin.tar.gz",
          "link": [
            {
              "source": "codex-aarch64-apple-darwin",
              "target": "codex"
            }
          ]
        },
        {
          "rid": "win-x64",
          "asset": "codex-x86_64-pc-windows-msvc.exe.zip",
          "link": [
            {
              "source": "codex-x86_64-pc-windows-msvc.exe",
              "target": "codex.exe"
            },
            {
              "source": "codex-windows-sandbox-setup.exe"
            },
            {
              "source": "codex-command-runner.exe"
            }
          ]
        }
      ]
    }
  ]
}
